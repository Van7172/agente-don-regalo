# Document root = public/ (subdominio) O carpeta /crm/public en el dominio

# Adjuntos del asesor. El mismo tope que `.user.ini`, para el caso mod_php, que
# no lee ese fichero. Va dentro de <IfModule> obligatoriamente: un `php_value`
# en un servidor sin mod_php no se ignora, devuelve un 500 y tumba el panel
# entero por intentar arreglar una subida.
<IfModule mod_php.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 20M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 20M
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Si está en /crm/public, descomenta la siguiente línea:
  RewriteBase /crm/public/

  # API agente / panel JSON
  RewriteRule ^api(?:/(.*))?$ api/index.php [QSA,L]

  # Assets y PHP existentes
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rutas amigables del panel
  RewriteRule ^login/?$ login.php [L]
  RewriteRule ^logout/?$ logout.php [L]
  RewriteRule ^reports/?$ reports.php [L]
  RewriteRule ^$ index.php [L]
</IfModule>
